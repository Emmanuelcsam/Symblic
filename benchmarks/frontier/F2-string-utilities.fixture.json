  "id": "frontier-f2-string-utilities-v1",
  "request": {
    "allowed_outputs": [
      "result.js"
    ],
    "artifact_format": "javascript_script",
    "assumptions": [],
    "budget": {
      "context_chars": 32768,
      "max_calls": 8,
      "max_candidates": 4,
      "max_depth": 4,
      "max_units": 64,
      "max_workers": 3,
      "retries": 2,
      "wall_seconds": 300
    },
    "exports": [
      {
        "name": "slugify",
        "signature": "slugify(text)"
      },
      {
        "name": "padLeft",
        "signature": "padLeft(text,width,fill)"
      },
      {
        "name": "wordCount",
        "signature": "wordCount(text)"
      }
    ],
    "language": "javascript",
    "objective": "Build three JavaScript string utilities, slugify, padLeft and wordCount, with exact Unicode handling. Return plain JavaScript source defining slugify, padLeft and wordCount as top-level functions.",
    "requirements": [
      {
        "acceptance": "TESTED",
        "id": "slug",
        "text": "slugify(text) builds a URL slug: apply String.prototype.normalize('NFD'); delete combining marks U+0300 to U+036F; lowercase ASCII A-Z; replace each maximal run of characters other than ASCII a-z and 0-9 with one '-'; remove leading and trailing '-'. The result may be the empty string."
      },
      {
        "acceptance": "TESTED",
        "id": "pad",
        "text": "padLeft(text,width,fill) prefixes copies of fill until the result has width Unicode code points (an emoji or any other astral character counts as one code point, not two UTF-16 units); text that already has width or more code points is returned unchanged. fill defaults to one space when omitted or undefined."
      },
      {
        "acceptance": "TESTED",
        "id": "words",
        "text": "wordCount(text) returns the number of words: maximal runs of Unicode letters (\\p{L}), marks (\\p{M}) and decimal digits (\\p{Nd}). An apostrophe (U+0027 or U+2019) with a word character immediately before and after it joins them into one word. Every other character (whitespace, punctuation including '_' and '-', symbols, emoji) separates words."
      },
      {
        "acceptance": "TESTED",
        "id": "types",
        "text": "Throw an Error when text is not a string, when width is not an integer from 0 to 1000, or when fill is not a string of exactly one code point."
      }
    ],
    "tests": [
      {
        "call": "slugify(\"Hello, World!\")",
        "expected": "\"hello-world\"",
        "requirement_ids": [
          "slug"
        ]
      },
      {
        "call": "slugify(\"\\u00c7a va?\")",
        "expected": "\"ca-va\"",
        "requirement_ids": [
          "slug"
        ]
      },
      {
        "call": "padLeft(\"42\",5,\"0\")",
        "expected": "\"00042\"",
        "requirement_ids": [
          "pad"
        ]
      },
      {
        "call": "padLeft(\"\\ud83d\\ude42\",3,\".\")",
        "expected": "\"..\\ud83d\\ude42\"",
        "requirement_ids": [
          "pad"
        ]
      },
      {
        "call": "wordCount(\"one two  three\")",
        "expected": "3",
        "requirement_ids": [
          "words"
        ]
      },
      {
        "call": "wordCount(\"don't panic\")",
        "expected": "2",
        "requirement_ids": [
          "words"
        ]
      },
      {
        "call": "(()=>{try{slugify(7);return false}catch(e){return e instanceof Error}})()",
        "expected": "true",
        "requirement_ids": [
          "types"
        ]
      }
    ],
    "version": 1
  },
  "split": "dev"
}
