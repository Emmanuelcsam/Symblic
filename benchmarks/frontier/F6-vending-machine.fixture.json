      {
        "name": "vend",
        "signature": "vend(prices,events)"
      }
    ],
    "language": "javascript",
    "objective": "Build vend(prices,events), a deterministic vending machine simulation that reports one output per event. Return plain JavaScript source defining vend as a top-level function.",
    "requirements": [
      {
        "acceptance": "TESTED",
        "id": "machine",
        "text": "vend(prices,events) simulates a vending machine that starts with credit 0, processes the events in order and returns {\"credit\":c,\"outputs\":list}: the final credit and exactly one output object per event."
      },
      {
        "acceptance": "TESTED",
        "id": "coin",
        "text": "A {\"type\":\"coin\",\"value\":v} event with v equal to 5, 10, 25 or 100 adds v to the credit and outputs {\"type\":\"credit\",\"credit\":newCredit}; any other safe integer v leaves the credit unchanged and outputs {\"type\":\"reject\",\"value\":v}."
      },
      {
        "acceptance": "TESTED",
        "id": "select",
        "text": "A {\"type\":\"select\",\"item\":s} event outputs {\"type\":\"error\",\"reason\":\"unknown_item\"} when s is not an own property of prices, {\"type\":\"error\",\"reason\":\"insufficient_credit\",\"needed\":price-credit} when the credit is below the price, and otherwise {\"type\":\"vend\",\"item\":s,\"change\":credit-price}, after which the credit is 0."
      },
      {
        "acceptance": "TESTED",
        "id": "refund",
        "text": "A {\"type\":\"refund\"} event outputs {\"type\":\"refund\",\"amount\":credit} and sets the credit to 0."
      },
      {
        "acceptance": "TESTED",
        "id": "errors",
        "text": "Throw an Error when prices is not a plain object whose values are positive safe integers, when events is not an array, or when an event is not an object whose type is \"coin\" with a safe-integer value, \"select\" with a string item, or \"refund\"."
      }
    ],
