  "id": "frontier-f3-collection-algebra-v1",
  "request": {
    "allowed_outputs": [
      "result.js"
    ],
    "artifact_format": "javascript_script",
    "assumptions": [],
    "budget": {
      "context_chars": 32768,
      "max_calls": 8,
      "max_candidates": 4,
      "max_depth": 4,
      "max_units": 64,
      "max_workers": 3,
      "retries": 2,
      "wall_seconds": 300
    },
    "exports": [
      {
        "name": "groupBy",
        "signature": "groupBy(items,key)"
      },
      {
        "name": "histogram",
        "signature": "histogram(values)"
      },
      {
        "name": "sortBy",
        "signature": "sortBy(items,key,order)"
      }
    ],
    "language": "javascript",
    "objective": "Build three JavaScript collection functions, groupBy, histogram and sortBy, that are pure and safe for any key name. Return plain JavaScript source defining groupBy, histogram and sortBy as top-level functions.",
    "requirements": [
      {
        "acceptance": "TESTED",
        "id": "group",
        "text": "groupBy(items,key) groups an array of objects by String(item[key]). Every item must have key as an own property whose value is a string or a safe integer. Return an object mapping each group name to an array of the items with that name, in input order."
      },
      {
        "acceptance": "TESTED",
        "id": "hist",
        "text": "histogram(values) counts String(value) for an array of strings and safe integers into an object mapping each name to its count; 1 and \"1\" share the name \"1\"."
      },
      {
        "acceptance": "TESTED",
        "id": "sort",
        "text": "sortBy(items,key,order) returns a new array of the same items ordered by their own property key, ascending when order is \"asc\" or omitted and descending when order is \"desc\". The values must be all finite numbers (compared numerically) or all strings (compared by UTF-16 code units, like the JavaScript < operator). Items with equal values keep their input order in both directions."
      },
      {
        "acceptance": "TESTED",
        "id": "keys",
        "text": "Returned objects hold every group or count name as an own enumerable property, including __proto__, constructor, toString and the empty string."
      },
      {
        "acceptance": "TESTED",
        "id": "pure",
        "text": "Never mutate the input arrays or their items."
      },
      {
        "acceptance": "TESTED",
        "id": "errors",
        "text": "Throw an Error when items or values is not an array, key is not a string, an item is not a non-null non-array object or lacks the own property key, a groupBy or histogram value is not a string or safe integer, a sortBy value is neither a finite number nor a string, sortBy values mix numbers and strings, or order is anything other than \"asc\", \"desc\" or omitted."
      }
    ],
    "tests": [
      {
        "call": "groupBy([{\"t\":\"a\",\"v\":1},{\"t\":\"b\",\"v\":2},{\"t\":\"a\",\"v\":3}],\"t\")",
        "expected": "{\"a\":[{\"t\":\"a\",\"v\":1},{\"t\":\"a\",\"v\":3}],\"b\":[{\"t\":\"b\",\"v\":2}]}",
        "requirement_ids": [
          "group"
        ]
      },
      {
        "call": "histogram([\"x\",\"y\",\"x\"])",
        "expected": "{\"x\":2,\"y\":1}",
        "requirement_ids": [
          "hist"
        ]
      },
      {
        "call": "histogram([\"constructor\",\"constructor\"])",
        "expected": "{\"constructor\":2}",
        "requirement_ids": [
          "keys"
        ]
      },
      {
        "call": "sortBy([{\"n\":3},{\"n\":1},{\"n\":2}],\"n\")",
        "expected": "[{\"n\":1},{\"n\":2},{\"n\":3}]",
        "requirement_ids": [
          "sort"
        ]
      },
      {
        "call": "sortBy([{\"n\":1,\"id\":\"a\"},{\"n\":2,\"id\":\"b\"},{\"n\":1,\"id\":\"c\"}],\"n\",\"desc\")",
        "expected": "[{\"n\":2,\"id\":\"b\"},{\"n\":1,\"id\":\"a\"},{\"n\":1,\"id\":\"c\"}]",
        "requirement_ids": [
          "sort"
        ]
      },
      {
        "call": "(()=>{const xs=[{\"n\":2},{\"n\":1}];sortBy(xs,\"n\");return xs})()",
        "expected": "[{\"n\":2},{\"n\":1}]",
        "requirement_ids": [
          "pure"
        ]
      },
      {
        "call": "(()=>{try{histogram([null]);return false}catch(e){return e instanceof Error}})()",
        "expected": "true",
        "requirement_ids": [
          "errors"
        ]
      }
    ],
    "version": 1
  },
