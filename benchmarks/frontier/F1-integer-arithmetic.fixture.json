  "id": "frontier-f1-integer-arithmetic-v1",
  "request": {
    "allowed_outputs": [
      "result.js"
    ],
    "artifact_format": "javascript_script",
    "assumptions": [],
    "budget": {
      "context_chars": 32768,
      "max_calls": 8,
      "max_candidates": 4,
      "max_depth": 4,
      "max_units": 64,
      "max_workers": 3,
      "retries": 2,
      "wall_seconds": 300
    },
    "exports": [
      {
        "name": "gcd",
        "signature": "gcd(a,b)"
      },
      {
        "name": "lcm",
        "signature": "lcm(a,b)"
      },
      {
        "name": "isPrime",
        "signature": "isPrime(n)"
      }
    ],
    "language": "javascript",
    "objective": "Build a small JavaScript integer library with gcd, lcm and isPrime and strict input checks. Return plain JavaScript source defining gcd, lcm and isPrime as top-level functions.",
    "requirements": [
      {
        "acceptance": "TESTED",
        "id": "gcd",
        "text": "gcd(a,b) returns the greatest common divisor of the safe integers a and b as a nonnegative integer. Signs are ignored and gcd(0,0) is 0."
      },
      {
        "acceptance": "TESTED",
        "id": "lcm",
        "text": "lcm(a,b) returns the least common multiple of the safe integers a and b as a nonnegative integer; it is 0 when either argument is 0. The result must be exact: throw an Error when it would exceed 9007199254740991."
      },
      {
        "acceptance": "TESTED",
        "id": "prime",
        "text": "isPrime(n) returns true exactly when the integer n is a prime number; 0, 1 and negative integers are not prime. It accepts -1000000 <= n <= 1000000 and throws an Error for any n outside that range."
      },
      {
        "acceptance": "TESTED",
        "id": "domain",
        "text": "Every function throws an Error when an argument is missing or is not a safe integer (Number.isSafeInteger is false): fractions, NaN, Infinity, numbers beyond 9007199254740991 in magnitude, strings, booleans, null, arrays and objects."
      }
    ],
    "tests": [
      {
        "call": "gcd(12,18)",
        "expected": "6",
        "requirement_ids": [
          "gcd"
        ]
      },
      {
        "call": "lcm(4,6)",
        "expected": "12",
        "requirement_ids": [
          "lcm"
        ]
      },
      {
        "call": "isPrime(13)",
        "expected": "true",
        "requirement_ids": [
          "prime"
        ]
      },
      {
        "call": "(()=>{try{gcd(2.5,5);return false}catch(e){return e instanceof Error}})()",
        "expected": "true",
        "requirement_ids": [
          "domain"
        ]
      }
    ],
    "version": 1
  },
  "split": "dev"
