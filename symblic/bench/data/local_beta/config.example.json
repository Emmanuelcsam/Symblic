{
  "version": 1,
  "about": "Example configuration for python3 -m symblic.bench.local_beta. Copy it, list your own Ollama nodes and models, and pass --config. Relative paths resolve against this file's folder; a path starting with @repo/ resolves against the repository root. See symblic/bench/README.md.",
  "models": ["qwen3:4b-instruct", "phi4-mini", "gemma3:4b", "ministral-3:3b", "qwen2.5-coder:3b", "granite3.3:2b",
             "deepseek-r1:1.5b", "gemma3:1b", "llama3.2:1b", "qwen2.5:0.5b"],
  "nodes": ["node-a", "node-b"],
  "reserved_nodes": [],
  "excluded_nodes": [],
  "hot_celsius": 80,
  "commands": {
    "vitals": null,
    "active_runs": null,
    "cancel_run": null,
    "inventory": null,
    "research": null
  },
  "search_health_url": null,
  "fixtures": {
    "four-plus-four": {"lane": "native", "path": "fixtures/native/four-plus-four.sym",
                       "expect": {"kernel and model agree": "[8, 8]"}, "total_seconds": 900},
    "word-problem": {"lane": "native", "path": "fixtures/native/word-problem.sym", "expect": {"rolls left": "44"},
                     "total_seconds": 900,
                     "note": "its ensure only checks a whole number >= 0; the right answer 44 is checked here"},
    "small-model-math": {"lane": "native", "path": "fixtures/native/small-model-math.sym", "model_calls": 0,
                         "total_seconds": 900,
                         "note": "replays model-written code with no model call: a kernel-only control"},
    "count-and-prime": {"lane": "native", "path": "fixtures/native/count-and-prime.sym",
                        "expect": {"count and primality": "[3, false]"}, "total_seconds": 900},
    "minutes-split": {"lane": "native", "path": "fixtures/native/minutes-split.sym",
                      "expect": {"hours and minutes": "[2, 15]"}, "total_seconds": 900},
    "falling-number": {"lane": "english", "path": "fixtures/english/falling-number.english.txt",
                       "max_calls": 24, "wall_seconds": 1800},
    "categorize": {"lane": "english", "path": "fixtures/english/categorize.english.txt",
                   "expect": {"category": "complaint"}, "max_calls": 6, "wall_seconds": 900,
                   "note": "no Accept line: the expected label is checked here"},
    "change": {"lane": "english", "path": "fixtures/english/change.english.txt", "expect": {"change": "14"},
               "max_calls": 12, "wall_seconds": 900},
    "witness-delivery": {"lane": "delegate", "path": "fixtures/delegate/witness-delivery.task.json",
                         "expect_result": {"path": ["quote"], "equals": "Delivery: Monday\n"}, "wall_seconds": 900},
    "classify-complaint": {"lane": "delegate", "path": "fixtures/delegate/classify-complaint.task.json",
                           "expect_result": {"path": [], "equals": "complaint"}, "wall_seconds": 900},
    "ladder-F1": {"lane": "ladder", "path": "@repo/benchmarks/frontier/ladder.json", "family": "F1",
                  "budget_seconds": 900, "max_calls": 8,
                  "note": "the MICA frontier ladder, family F1, six rungs: a separate long trial"},
    "doi-alphafold": {"lane": "research",
                      "question": "What is the exact title of the journal article with DOI 10.1038/s41586-021-03819-2? Give the title.",
                      "expect": "Highly accurate protein structure prediction with AlphaFold",
                      "source": "https://api.crossref.org/works/10.1038/s41586-021-03819-2 (Nature, 2021)",
                      "tools": 4, "wall_seconds": 1200},
    "doi-ml-trends": {"lane": "research",
                      "question": "What is the exact title of the journal article with DOI 10.1126/science.aaa8415? Give the title.",
                      "expect": "Machine learning: Trends, perspectives, and prospects",
                      "source": "https://api.crossref.org/works/10.1126/science.aaa8415 (Science, 2015)",
                      "tools": 4, "wall_seconds": 1200}
  },
  "batches": {
    "first": {"pairs": ["qwen3:4b-instruct@node-a", "gemma3:1b@node-b"],
              "trials": [["native", "four-plus-four"], ["native", "word-problem"], ["native", "count-and-prime"],
                         ["english", "change"], ["delegate", "classify-complaint"]]},
    "kernel-only": {"pairs": ["gemma3:1b@node-a"], "trials": [["native", "small-model-math"]]}
  }
}
