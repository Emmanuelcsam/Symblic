# ------------------------------------------------------------------------------ autogen

def autogen_requested(o):
    return any(key in o for key in AUTOGEN_FLAGS)


def _int_flag(o, key):
    try:
        return int(o[key])
    except (TypeError, ValueError):
        raise ApiError(f'--{key.replace("_", "-")} needs a whole number, not {o[key]!r}', USAGE) from None


def autogen_policy(o, lines):
    """The autogen policy object from the command line: only the fields given (a given 0 stays 0); the server
    fills the defaults and refuses out-of-range values. With --until-done, agents_max and wall_seconds left out
    default to 0 (unlimited), and a given --agents-max/--wall-seconds N is honoured as a safety cap (the run then
    ends stuck, never failed), so the two are sent only when the operator gives them."""
    spec = {}
    for flag, field in AUTOGEN_INT_FLAGS:
        if flag in o:
            spec[field] = _int_flag(o, flag)
    if 'perpetual' in o:
        spec['perpetual'] = True
        spec['interval_seconds'] = _int_flag(o, 'perpetual')
    if 'strategies' in o:
        spec['strategies'] = [s.strip() for s in o['strategies'].split(',') if s.strip()]
    if o.get('check'):
        checks = {}
        for item in o['check']:
            index, sep, command = item.partition(':')
            index = index.strip()
            if not sep or not index.isdigit() or not command.strip():
                raise ApiError(f"--check takes 'INDEX:command' with INDEX the 0-based statement index, not {item!r}", USAGE)
            if int(index) >= len(lines):
                raise ApiError(f'--check {index}: there are {len(lines)} statement(s), indexed from 0', USAGE)
            checks.setdefault(str(int(index)), []).append(command.strip())
        spec['checks'] = checks
    for key in ('final', 'hidden'):
        if o.get(key):
            spec[key] = [c.strip() for c in o[key]]
    if o.get('no_syntax'):
        spec['syntax'] = False
    if o.get('allow_no_change'):
        spec['require_change'] = False
    if o.get('until_done'):
        spec['until_done'] = True
    if o.get('designer'):
        spec['designer'] = True
    if o.get('no_self_split'):
        spec['self_split'] = False
    return spec


def cmd_autogen_start(o, lines):
    for flag, key in (('--parallel', 'parallel'), ('--worktree', 'worktree'), ('--auto-next', 'auto_next'),
                      ('--no-auto', 'no_auto')):
        if o.get(key):
            print(f'{flag} does not apply to an autogen run: every attempt is its own one-statement task in its '
                  'own checkout, accepted by code'); return USAGE
    if o.get('mode') == 'agent':
        print('--mode agent does not apply to an autogen run: each nonblank line is one statement'); return USAGE
    root = o.get('root', '').rstrip('/')
    cwd = o.get('cwd') or root
    # The server lints with the workspace as the root; so does this.
    findings = lint(lines, root or cwd)
    if any(f[0] == 'error' for f in findings):
        print_lint(findings); return REFUSED
    if findings and not o.get('json'):
        print_lint(findings)
    if not cwd:
        print('name the workspace: --root DIR (or --cwd DIR), a git workspace; create one with: symblic-task workspace NAME'); return USAGE
    policy = autogen_policy(o, lines)
    module = policy_module()
    if module is not None and callable(getattr(module, 'normalize', None)):
        try:
            module.normalize(policy)
        except ValueError as e:
            print(f'autogen policy refused: {e}'); return USAGE
    note = ''
    if o.get('context_note'):
        with open(o['context_note'], encoding='utf-8') as f:
            note = f.read().strip()
    note = (AUTOGEN_FOLDER.format(cwd=cwd) + ' ' + CHECKOUT_LOCK + ('\n\n' + note if note else ''))[:12000]
    slug = re.sub(r'[^a-z0-9]+', '-', ' '.join(lines)[:40].lower()).strip('-') or 'task'
    request_id = o.get('id') or f'{slug}-{int(time.time())}'
    if len(request_id) > AUTOGEN_ID_MAX:
        print(f'--id is at most {AUTOGEN_ID_MAX} characters for an autogen run (attempt ids extend it)'); return USAGE
    body = {'client_request_id': request_id, 'instruction': '\n'.join(lines), 'node': o.get('node') or 'host',
            'cwd': cwd, 'context_note': note, 'headless': not o.get('no_headless'), 'autogen': policy}
    for key in ('engine', 'model', 'effort'):
        if o.get(key):
            body[key] = o[key]
    body.setdefault('engine', 'agy')
    d = request('autogen/start', body)
    run = d.get('run') or {}
    if o.get('json'):
        print(json.dumps({'id': run.get('id'), 'duplicate': d.get('duplicate'), 'run': run_view(run)}, indent=2, ensure_ascii=False))
    else:
        budget = run.get('budget') or {}
        print(f'{run.get("id")}  {"(duplicate of an earlier start)" if d.get("duplicate") else "started"}  '
              f'{len(lines)} statement(s) on {body["node"]} via {body["engine"]}  workspace {cwd}  '
              f'agents_max {_agents_cap(budget)}{"  until done" if _until_done(run) else ""}')
        print(f'follow: symblic-task autogen wait {run.get("id")}')
    return OK


def sheet_problems(text):
    """symblic.spec.sheets' problems for a spec sheet, from this checkout (the server checks again), or None when it
    cannot be imported here."""
    added = CHECKOUT_ROOT not in sys.path
    if added:
        sys.path.insert(0, CHECKOUT_ROOT)
    try:
        from symblic.spec import sheets as symblic_spec
        try:
            return list(symblic_spec.problems(symblic_spec.parse(text)))
        except ValueError as e:                  # SheetError: a section the format does not know
            return [str(e)]
    except Exception:
        return None
    finally:
        if added and CHECKOUT_ROOT in sys.path:
            sys.path.remove(CHECKOUT_ROOT)


