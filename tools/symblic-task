#!/usr/bin/env python3
"""symblic-task: a command-line client of a host's Symblic task engine (/api/symblicos/). Stdlib, loopback only.

    symblic-task catalog [--json]                       engines, models, machines and modes the engine offers
    symblic-task workspace NAME                         create the project folder NAME on the host (idempotent)
    symblic-task lint FILE [--root DIR]                 check the statements before any agent minute is spent
    symblic-task start --lines FILE | --instruction TEXT | --sheet SHEET.md
                 [--root DIR] [--cwd DIR] [--node NODE] [--engine E] [--model M] [--effort E]
                 [--mode lines|agent] [--context-note FILE] [--parallel N] [--id ID] [--no-auto] [--worktree]
                 [--auto-next] [--headless] [--json]
                 --auto-next accepts a line whose agent process ended with evidence (no refusal, no claim the
                 disk contradicts) and launches the next line unattended; --headless runs agy/claude/mistral
                 in print mode so the process ends when the turn ends. Use both for unattended lines on a node.
    symblic-task get ID [--screen] [--json]             one task: status, steps, evidence, warnings
    symblic-task wait ID [--max SECONDS] [--interval S] [--json]
                                                        poll until a line awaits review or the task ends; print the summary
    symblic-task next ID | resume ID | cancel ID        finish the reviewed line and launch the next; re-attach; stop
    symblic-task list [--status S] [--limit N] [--json] the ledger, newest first
    symblic-task start ... --autogen [--candidates K] [--regenerate R] [--decompose D] [--children C] [--handoff G]
                 [--perpetual SECONDS] [--agents-max N] [--attempt-seconds S] [--wall-seconds S]
                 [--strategies fresh,feedback,other_node,other_engine,stronger_model] [--check 'INDEX:command']...
                 [--final 'command']... [--hidden 'command']... [--no-syntax] [--allow-no-change] [--no-headless]
                 [--until-done] [--designer] [--no-self-split] [--novelty-limit N] [--saturation N]
                 any of these makes the start an autogen run: K candidates per statement in own checkouts, R
                 regenerations, splits up to depth D into C lines, G handoff generations, verdicts by code only;
                 --check INDEX is the 0-based statement index; --check/--final/--hidden repeat.
                 One agent per line is the default (--candidates 1). --until-done removes the clock and count caps
                 unless you give --agents-max/--wall-seconds explicitly (a safety cap: the run then ends stuck,
                 never failed): agents keep regenerating, subdividing and re-planning until the checks pass or the
                 node is stuck. --designer: a first agent writes AUTOGEN-TESTS.sh, checked on every candidate;
                 --no-self-split: no worker may answer with AUTOGEN-SPLIT.txt; --novelty-limit N: attempts without
                 progress before a node is split; --saturation N: a perpetual lane stops after N generations in a
                 row find nothing new (0 never)
    symblic-task start --sheet SHEET.md --root DIR --model MODEL --node NODE [--engine local] --autogen [...]
                 a spec sheet (docs/reference/SPEC-SHEETS.md) as ONE autogen statement on the kernel lane: a light local
                 model writes its units one fresh context at a time, js_test checks each, the file is assembled from
                 passing units; regenerations keep the units an earlier build accepted, a stalled unit is split
                 (docs/reference/LOCAL-AUTOGEN.md); --check 0:command adds the operator's check on the assembled file
    symblic-task autogen list [--status S] [--limit N] [--json] | catalog [--json]
    symblic-task autogen get RUN_ID [--tasks] [--json]  the run tree: nodes, attempts, winner, budget, final checks
    symblic-task autogen wait RUN_ID [--max S] [--interval S] [--json]
                                                        poll until the run ends; one line per status change
    symblic-task autogen cancel RUN_ID | resume RUN_ID [--agents-max N] [--wall-seconds S]
                                                        stop every attempt; re-attach the coordinator, or reopen a
                                                        stuck run after changing the statement, checks or catalogue;
                                                        resume's flags raise a spent cap (0 lifts it under until_done)

The engine starts one fresh agent per nonblank line (lines mode) in the workspace you name, keeps a durable
record per task, and never trusts the agent's own claims. `tools/symblic lanes` prints the statement
rules; `lint` applies them. --root DIR sets the workspace and puts the beta-proven folder lock into the
context note. Options are top-level task fields; a nested "options" object is refused by the server.

Exit codes: 0 fine, 1 the engine refused or the task failed (or the autogen run is stuck), 2 bad command line
or the routes are not live, 3 the host is not answering, 4 wait reached --max.

Host-only: every command except `lint` (and --help) talks to the task API of the original host system
(integration/host/symblicos_engine.py and symblicos_tasks.py hold its server side), which is not part of this
repository. Without such a host those commands exit 3 (nothing answers) or 2 (the routes are absent).
`lint` runs locally: it applies symblic.autogen.policy.lint, or the copy of its rules below (local_lint)
when the package cannot be imported. Set SYMBLIC_TASK_URL to the host's loopback address
(default http://127.0.0.1:8080, where the original host listened).
"""
import importlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = 'http://127.0.0.1:8080'
LOOPBACK_HOSTS = ('127.0.0.1', '::1', 'localhost')
BASE = (os.environ.get('SYMBLIC_TASK_URL') or DEFAULT_URL).strip().rstrip('/')
API = '/api/symblicos/'
TIMEOUT = 60
TERMINAL = ('completed', 'cancelled', 'failed', 'unknown')
AUTOGEN_TERMINAL = TERMINAL + ('stuck',)   # stuck (until_done): nothing novel left; autogen resume reopens it
MAX_LINES, MAX_CHARS = 64, 60000
OK, REFUSED, USAGE, NO_ANSWER, TIMED_OUT = 0, 1, 2, 3, 4
VERBS = ('create', 'extend', 'add', 'write', 'run', 'make', 'build', 'update', 'replace', 'remove', 'delete',
         'verify', 'check', 'implement', 'rename', 'move', 'copy', 'install', 'generate', 'produce', 'append',
         'record', 'fix', 'rewrite', 'convert', 'export', 'read', 'inspect', 'test', 'compile', 'document', 'split',
         'index', 'monitor', 'watch', 'collect', 'summarize', 'summarise', 'research', 'scan')  # keep equal to symblic.autogen.policy.VERBS
CHECKOUT_LOCK = ('Your working folder is exactly the git checkout you were started in (run pwd once). Every file '
                 'your statement names is created or modified directly in that checkout, at the relative path '
                 'given. Do not explore other tests, modules or folders, do not investigate this machine or '
                 'your own environment, do not start background searches; read only the files your statement '
                 'names, execute your statement and finish. Keep every name, count and behavior exactly as your '
                 'statement fixes it.')
FOLDER_LOCK = ('Your working folder is exactly {root}; every file your statement names is created or modified '
               'directly in that folder. Do not explore, search or read anything outside that folder; do not '
               'investigate this machine, other projects, your prompt files or your own environment; do not start '
               'background searches; execute your statement and finish. Keep every name, count and behavior exactly '
               'as your statement fixes it.')
# Autogen candidates run in their own checkouts, so the folder lock above (which names the project
# folder) would send them into the operator's copy; this note maps the named folder onto the checkout.
AUTOGEN_FOLDER = ('You are one autogen candidate working in your own git checkout of the project workspace {cwd}. '
                  'Where a statement names the folder {cwd}, use the same relative path inside your checkout '
                  'instead; never write into {cwd} itself (the owner\'s copy; code promotes accepted results there).')
AUTOGEN_INT_FLAGS = (('candidates', 'candidates'), ('regenerate', 'regenerate'), ('decompose', 'depth'),
                     ('children', 'children'), ('handoff', 'generations'), ('agents_max', 'agents_max'),
                     ('attempt_seconds', 'attempt_seconds'), ('wall_seconds', 'wall_seconds'),
                     ('novelty_limit', 'novelty_limit'), ('saturation', 'saturation'))
AUTOGEN_FLAGS = ('autogen', 'perpetual', 'strategies', 'check', 'final', 'hidden', 'no_syntax',
                 'allow_no_change', 'until_done', 'designer', 'no_self_split', 'sheet') + tuple(flag for flag, _ in AUTOGEN_INT_FLAGS)
AUTOGEN_ID_MAX = 120   # the coordinator appends ':<node>-a<n>' to make each attempt's 160-character task id
CHECKOUT_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_POLICY = None         # symblic.autogen.policy once imported; False when this checkout does not have it


class ApiError(Exception):
    def __init__(self, message, exit_code=REFUSED, data=None, status=None):
        super().__init__(message)
        self.exit_code = exit_code
        self.data = data or {}
        self.status = status          # the HTTP status of a refusal the server answered


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())


def loopback_base(raw):
    raw = (raw or DEFAULT_URL).strip().rstrip('/')
    u = urllib.parse.urlsplit(raw)
    if u.scheme != 'http' or (u.hostname or '').lower() not in LOOPBACK_HOSTS or u.path or u.query:
        raise ApiError(f'SYMBLIC_TASK_URL must be the host on this machine, like {DEFAULT_URL}', USAGE)
    return raw


def request(route, body=None, query=None):
    base = loopback_base(BASE)
    url = base + API + route + ('?' + urllib.parse.urlencode(query) if query else '')
    data = None if body is None else json.dumps(body).encode('utf-8')
    req = urllib.request.Request(url, data=data, method='GET' if body is None else 'POST')
    req.add_header('Host', urllib.parse.urlsplit(base).netloc)
    req.add_header('Accept', 'application/json')
    req.add_header('User-Agent', 'symblic-task-cli')
    if data is not None:
        req.add_header('Content-Type', 'application/json')
    try:
        with OPENER.open(req, timeout=TIMEOUT) as res:
            return json.loads(res.read().decode('utf-8') or '{}')
    except urllib.error.HTTPError as e:
        raw = e.read().decode('utf-8', 'replace')
        try:
            payload = json.loads(raw or '{}')
        except ValueError:
            payload = {}
        if e.code == 404 and not payload:
            raise ApiError(f'The /api/symblicos/ routes are not served at {base}: this command needs a host that serves '
                           'them (see integration/host/README.md).', USAGE) from None
        raise ApiError(f'HTTP {e.code}: {payload.get("error") or raw[:300] or "no reason given"}', REFUSED, payload,
                       status=e.code) from None
    except urllib.error.URLError as e:
        raise ApiError(f'The host is not answering at {base} ({e.reason}).', NO_ANSWER) from None
    except (TimeoutError, OSError) as e:
        raise ApiError(f'The host did not answer at {base} ({e}).', NO_ANSWER) from None


# ------------------------------------------------------------------------------ statements

def statements(text):
    return [line.strip() for line in text.splitlines() if line.strip()]


def policy_module():
    """symblic.autogen.policy from this checkout (the server applies the same rules), or None when absent."""
    global _POLICY
    if _POLICY is None:
        added = CHECKOUT_ROOT not in sys.path
        if added:
            sys.path.insert(0, CHECKOUT_ROOT)
        try:
            module = importlib.import_module('symblic.autogen.policy')
            _POLICY = module if callable(getattr(module, 'lint', None)) else False
        except Exception:          # absent, or mid-edit in the live checkout: the local rules apply
            _POLICY = False
        finally:
            if added and CHECKOUT_ROOT in sys.path:
                sys.path.remove(CHECKOUT_ROOT)   # keep the checkout from shadowing later imports
    return _POLICY or None


def lint(lines, root=''):
    """Findings as (level, line_no, message). Errors stop a start; warnings print. The rules are
    single-sourced in symblic.autogen.policy.lint; local_lint is the fallback when it cannot be imported."""
    module = policy_module()
    if module is not None:
        return [tuple(f) for f in module.lint(lines, root)]
    return local_lint(lines, root)


def local_lint(lines, root=''):
    """Findings as (level, line_no, message). Errors stop a start; warnings print."""
    out = []
    if not lines:
        return [('error', 0, 'no statements: the file has no nonblank line')]
    if len(lines) > MAX_LINES:
        out.append(('error', 0, f'{len(lines)} statements; the engine takes at most {MAX_LINES} per task'))
    if sum(len(x) + 1 for x in lines) > MAX_CHARS:
        out.append(('error', 0, f'the statements exceed {MAX_CHARS} characters in total'))
    names_folder = re.compile(r'(?:in|into|inside|under) the folder /[^\s,;]+|/home/[^\s,;]+')
    pronoun_only = re.compile(r'^(?:it|this|that|the (?:file|folder|project|previous|same) )', re.I)
    extend = re.compile(r'^(?:extend|update|modify|change|edit|rewrite|revise)\b', re.I)
    verify_line = any(re.search(r'\bverif', x, re.I) and re.search(r'\.txt\b', x) for x in lines)
    for n, line in enumerate(lines, 1):
        if len(line) < 20:
            out.append(('error', n, 'shorter than 20 characters: one full self-contained statement per line'))
        if len(line) > 1500:
            out.append(('warning', n, 'longer than 1500 characters: split it into one concern per line'))
        first = re.match(r'[A-Za-z]+', line)
        if not first or first.group(0).lower() not in VERBS:
            out.append(('warning', n, 'does not start with an action verb (Create the file X ..., Extend the file Y ...)'))
        if not names_folder.search(line) and not root:
            out.append(('warning', n, 'names no absolute folder; fresh agents cannot resolve "the current folder" (write "in the folder /home/.../NAME" or pass --root)'))
        if pronoun_only.match(line):
            out.append(('warning', n, 'starts with a pronoun or "the file": name the file and folder, every line is a fresh context'))
        if extend.match(line) and 'keeping every existing part' not in line:
            out.append(('warning', n, 'an edit statement without "keeping every existing part": fresh agents replace what they do not see'))
        if re.search(r'\b(?:the previous|the last|as before|like above|earlier)\b', line, re.I):
            out.append(('warning', n, 'refers to earlier lines; a fresh agent sees only this line and the context note'))
    if not verify_line:
        out.append(('warning', 0, 'no verify statement: end with one that runs a concrete check and writes verify.txt in an exact format'))
    return out


def print_lint(findings, as_json=False):
    if as_json:
        print(json.dumps([{'level': lv, 'line': n, 'message': m} for lv, n, m in findings], indent=2))
    else:
        for lv, n, m in findings:
            print(f'{lv}{(" line " + str(n)) if n else ""}: {m}')
        errors = sum(1 for lv, _, _ in findings if lv == 'error')
        print(f'{len(findings)} finding(s), {errors} error(s)')
    return REFUSED if any(lv == 'error' for lv, _, _ in findings) else OK


# ------------------------------------------------------------------------------ printing

def step_summary(step):
    ev = step.get('evidence') or {}
    changes = (ev.get('changes') or {}) if isinstance(ev, dict) else {}
    comp = step.get('completion') or {}
    return {'index': step.get('index'), 'status': step.get('status'), 'agent': step.get('agent_id') or '',
            'running': bool(step.get('running')), 'stalled': bool(step.get('stalled')),
            'files_changed': changes.get('files_changed') if changes else None,
            'warning': (ev.get('warning') or '') if isinstance(ev, dict) else '',
            'error': step.get('error') or '', 'reason': (comp.get('reason') or '')[:160],
            'url': step.get('url') or '', 'instruction': (step.get('instruction') or '')[:100]}


def task_summary(task):
    steps = [step_summary(s) for s in task.get('steps') or []]
    return {'id': task.get('id'), 'status': task.get('status'), 'mode': task.get('mode'),
            'engine': (task.get('options') or {}).get('engine'), 'node': (task.get('options') or {}).get('node'),
            'workspace': task.get('workspace') or (task.get('options') or {}).get('cwd'),
            'error': task.get('error') or '', 'stalled_hint': task.get('stalled_hint') or '',
            'resume_required': bool(task.get('resume_required')), 'steps': steps,
            'next_action': next_action(task, steps)}


def next_action(task, steps):
    status = task.get('status')
    if status in TERMINAL:
        return 'done: verify the files and checks yourself; ' + status
    if task.get('resume_required'):
        return 'resume: the coordinator is absent (symblic-task resume ID)'
    gated = [s for s in steps if s['status'] == 'awaiting_review']
    if gated:
        s = gated[0]
        if s['running']:
            return f'wait: line {s["index"]} is gated but its agent is still running; inspect {s["url"]}, then next'
        return f'review: line {s["index"]} ended; read its evidence/files, then symblic-task next ID'
    if task.get('stalled_hint'):
        return 'inspect: a line has run 15 min without evidence; open its terminal url'
    return 'wait: lines are running'


def show(task, as_json=False, screen=False):
    s = task_summary(task)
    if as_json:
        if screen and task.get('screen'):
            s['screen'] = task['screen'][-4000:]
        print(json.dumps(s, indent=2, ensure_ascii=False))
        return
    print(f'{s["id"]}  {s["status"]}  {s["mode"]} on {s["node"]} via {s["engine"]}  workspace {s["workspace"]}')
    for st in s['steps']:
        flags = ' running' if st['running'] else ''
        flags += ' STALLED' if st['stalled'] else ''
        fc = '' if st['files_changed'] is None else f' files_changed={st["files_changed"]}'
        print(f'  [{st["index"]}] {st["status"]}{flags}{fc}  {st["instruction"]}')
        if st['warning']:
            print(f'      warning: {st["warning"]}')
        if st['error']:
            print(f'      error: {st["error"]}')
        if st['url']:
            print(f'      terminal: {st["url"]}')
    if s['error']:
        print(f'  error: {s["error"]}')
    if s['stalled_hint']:
        print(f'  {s["stalled_hint"]}')
    print(f'  next: {s["next_action"]}')
    if screen and task.get('screen'):
        print('--- screen tail ---')
        print(task['screen'][-2500:])


# ------------------------------------------------------------------------------ commands

def cmd_catalog(o):
    d = request('catalog')
    if o.get('json'):
        print(json.dumps(d, indent=2, ensure_ascii=False)); return OK
    print('modes:', ', '.join(d.get('modes') or []), '  parallel_max:', d.get('parallel_max'))
    nodes = d.get('nodes') or []
    print('machines:', ', '.join((n.get('id') or n.get('name') or str(n)) if isinstance(n, dict) else str(n) for n in nodes))
    for eng, spec in (d.get('specs') or {}).items():
        models = d.get('models', {}).get(eng) or []
        default = ((d.get('settings') or {}).get('engines') or {}).get(eng, {}).get('model') or ''
        print(f'  {eng:9} {len(models):3} models' + (f'  default {default}' if default else '') + f'  {(spec.get("blurb") or "")[:60]}')
    return OK


def cmd_workspace(o, args):
    if not args:
        print('workspace needs a NAME (a-z, 0-9, _ -)'); return USAGE
    d = request('workspace/create', {'name': args[0]})
    print(json.dumps(d, indent=2) if o.get('json') else f'{d.get("cwd")}  {"created" if d.get("created") else "exists"}')
    return OK


def read_lines_file(path):
    try:
        with open(path, encoding='utf-8') as f:
            return statements(f.read())
    except OSError as e:
        raise ApiError(f'cannot read {path}: {e}', USAGE) from None


def cmd_lint(o, args):
    if not args:
        print('lint needs a FILE of statements'); return USAGE
    return print_lint(lint(read_lines_file(args[0]), o.get('root', '')), o.get('json'))


def cmd_start(o):
    root = o.get('root', '').rstrip('/')
    if o.get('sheet'):
        if o.get('lines') or o.get('instruction'):
            print('--sheet takes the place of --lines and --instruction: the sheet is the one statement'); return USAGE
        return cmd_autogen_sheet(o)
    if o.get('lines'):
        lines = read_lines_file(o['lines'])
        mode = o.get('mode') or 'lines'
    elif o.get('instruction'):
        lines = statements(o['instruction'])
        mode = o.get('mode') or 'agent'
    else:
        print('start needs --lines FILE or --instruction TEXT'); return USAGE
    if mode not in ('lines', 'agent'):
        print('--mode is lines or agent'); return USAGE
    if autogen_requested(o):
        return cmd_autogen_start(o, lines)
    # In an own checkout (--worktree) the folder is the checkout the host creates, so the
    # absolute-folder rule does not apply; the lint is told a root exists.
    findings = lint(lines, root or ('<checkout>' if o.get('worktree') else '')) if mode == 'lines' else []
    errors = [f for f in findings if f[0] == 'error']
    if errors:
        print_lint(findings); return REFUSED
    if findings and not o.get('json'):
        print_lint(findings)
    cwd = o.get('cwd') or root
    if not cwd:
        print('name the workspace: --root DIR (or --cwd DIR); create one with: symblic-task workspace NAME'); return USAGE
    note = ''
    if o.get('context_note'):
        with open(o['context_note'], encoding='utf-8') as f:
            note = f.read().strip()
    if root:
        note = (FOLDER_LOCK.format(root=root) + ('\n\n' + note if note else ''))[:12000]
    elif o.get('worktree'):
        # An own checkout: the folder is wherever the host started the agent, so the lock names
        # it by pwd. Without it a fresh agent explored other tests for minutes (2026-10-10).
        note = (CHECKOUT_LOCK + ('\n\n' + note if note else ''))[:12000]
    slug = re.sub(r'[^a-z0-9]+', '-', ' '.join(lines)[:40].lower()).strip('-') or 'task'
    body = {'client_request_id': o.get('id') or f'{slug}-{int(time.time())}',
            'instruction': '\n'.join(lines), 'mode': mode, 'node': o.get('node') or 'host', 'cwd': cwd,
            'auto': not o.get('no_auto'), 'worktree': bool(o.get('worktree'))}
    for key in ('engine', 'model', 'effort'):
        if o.get(key):
            body[key] = o[key]
    body.setdefault('engine', 'agy')
    if note:
        body['context_note'] = note
    if o.get('parallel'):
        body['parallel'] = int(o['parallel'])
    if o.get('auto_next'):
        body['auto_next'] = True
    if o.get('headless'):
        body['headless'] = True
    d = request('tasks/start', body)
    task = d.get('task') or {}
    if o.get('json'):
        print(json.dumps({'id': task.get('id'), 'duplicate': d.get('duplicate'), 'task': task_summary(task)}, indent=2))
    else:
        print(f'{task.get("id")}  {"(duplicate of an earlier start)" if d.get("duplicate") else "started"}  '
              f'{len(lines)} line(s) on {body["node"]} via {body["engine"]}  workspace {cwd}')
        print(f'follow: symblic-task wait {task.get("id")}')
    return OK


def cmd_get(o, args):
    if not args:
        print('get needs a task ID'); return USAGE
    d = request('tasks/get', query={'id': args[0]})
    show(d.get('task') or {}, o.get('json'), screen=o.get('screen'))
    return OK


def cmd_wait(o, args):
    if not args:
        print('wait needs a task ID'); return USAGE
    limit = float(o.get('max') or 1800)
    interval = max(3.0, float(o.get('interval') or 15))
    started = time.time()
    last = ''
    outage = None
    while True:
        try:
            task = (request('tasks/get', query={'id': args[0]}) or {}).get('task') or {}
        except ApiError as e:
            # A restart of the host's web server drops a few polls; the
            # task record survives it, so the wait does too, for a bounded time.
            if e.exit_code != NO_ANSWER:
                raise
            outage = outage or time.time()
            if time.time() - outage > 180:
                raise
            if not o.get('json'):
                print(f'{time.strftime("%H:%M:%S")}  host not answering; retrying')
            time.sleep(5)
            continue
        outage = None
        s = task_summary(task)
        line = f'{s["status"]} ' + ' '.join(f'[{st["index"]}]{st["status"]}{"*" if st["running"] else ""}' for st in s['steps'])
        if line != last and not o.get('json'):
            print(f'{time.strftime("%H:%M:%S")}  {line}')
            last = line
        gate_ready = any(st['status'] == 'awaiting_review' and not st['running'] for st in s['steps'])
        if s['status'] in TERMINAL or gate_ready or s['resume_required']:
            show(task, o.get('json'), screen=True)
            return REFUSED if s['status'] in ('failed', 'unknown', 'cancelled') else OK
        if time.time() - started > limit:
            show(task, o.get('json'), screen=True)
            if not o.get('json'):
                print(f'wait: {limit:.0f}s reached; the task is still running (a gated line with a live TUI agent '
                      'never ends its turn from here: inspect its terminal, then `symblic-task next`)')
            return TIMED_OUT
        time.sleep(interval)


def cmd_control(action, o, args):
