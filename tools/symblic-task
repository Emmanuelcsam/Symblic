    title = next((line[2:].strip() for line in text.splitlines() if line.startswith('# ')), 'sheet')
    slug = re.sub(r'[^a-z0-9]+', '-', ('sheet ' + title)[:40].lower()).strip('-') or 'sheet'
    request_id = o.get('id') or f'{slug}-{int(time.time())}'
    if len(request_id) > AUTOGEN_ID_MAX:
        print(f'--id is at most {AUTOGEN_ID_MAX} characters for an autogen run (attempt ids extend it)'); return USAGE
    body = {'client_request_id': request_id, 'instruction': text, 'sheet': True, 'engine': 'local', 'model': o['model'],
            'node': node, 'cwd': cwd, 'context_note': note, 'headless': True, 'autogen': policy}
    if o.get('effort'):
        body['effort'] = o['effort']
    d = request('autogen/start', body)
    run = d.get('run') or {}
    if o.get('json'):
