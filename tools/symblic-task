        print(f'{run.get("id")}  {"(duplicate of an earlier start)" if d.get("duplicate") else "started"}  '
              f'spec sheet {title} on {node} via ollama:{o["model"]}  workspace {cwd}  '
              f'agents_max {_agents_cap(budget)}{"  until done" if _until_done(run) else ""}')
        print(f'follow: symblic-task autogen wait {run.get("id")}')
    return OK


def _when(ts, fmt='%m-%d %H:%M'):
    try:
        return time.strftime(fmt, time.localtime(float(ts))) if ts else '-'
    except (TypeError, ValueError, OverflowError, OSError):
        return '-'


def run_tree(run):
    """Nodes in execution order: each top statement followed by the lines it was split into."""
    nodes = [n for n in run.get('nodes') or [] if isinstance(n, dict)]
    by_id = {n.get('id'): n for n in nodes}
    out, seen = [], set()

    def walk(node_id):
        node = by_id.get(node_id)
        if node is None or node_id in seen:
            return
        seen.add(node_id)
        out.append(node)
        for child in node.get('children') or []:
            walk(child)
    for node_id in run.get('order') or [n.get('id') for n in nodes if n.get('parent') is None]:
        walk(node_id)
    out += [n for n in nodes if n.get('id') not in seen]
    return out


def statement_label(text):
    """One line for a statement: a spec sheet (a whole markdown file) shows as its title and unit count."""
    text = str(text or '')
    if text.startswith('# ') and '\n## Unit `' in text:
        title = text.split('\n', 1)[0][2:].strip()
        return f'spec sheet {title} ({text.count(chr(10) + "## Unit `")} units)'
    return ' '.join(text.split())


def _plural(n, word):
    return f'{n} {word}{"" if n == 1 else "s"}'


def _agents_cap(budget):
    """agents_max as shown: 0 means unlimited (an until_done run)."""
    cap = (budget or {}).get('agents_max', '?')
    return 'unlimited' if cap == 0 and not isinstance(cap, bool) else cap


def _until_done(run):
    return bool((run.get('policy') or {}).get('until_done') or (run.get('summary') or {}).get('until_done'))


def _count(value):
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


def _progress_counts(node):
    """A node's best measured progress as counts: files made or changed, checks passed, checkpoint items done."""
    progress = node.get('progress') if isinstance(node.get('progress'), dict) else {}
    files = progress.get('files')
    out = {'files': len(files) if isinstance(files, list) else _count(files),
           'checks': _count(progress.get('checks')), 'done': _count(progress.get('done'))}
    if 'units' in progress:                     # kernel lane: spec-sheet units the kernel accepted
        out['units'] = _count(progress.get('units'))
    return out


def run_next(run):
    status, rid = run.get('status'), run.get('id')
    if status == 'completed':
        return f'done: every statement accepted and promoted into {(run.get("base") or {}).get("cwd")}; verify the files yourself'
    if status == 'cancelled':
        return 'done: cancelled'
    if status == 'stuck':
        return (f'resume: symblic-task autogen resume {rid} [--agents-max N] [--wall-seconds S] after changing the '
                'statement, the checks or the catalogue')
    if status in ('failed', 'unknown'):
        hint = f'; inspect the attempts, then symblic-task autogen resume {rid}' if status == 'unknown' else ''
        return f'failed: {run.get("error") or status}{hint}'
    if run.get('resume_required'):
        return f'resume: the coordinator is absent (symblic-task autogen resume {rid})'
    for node in run_tree(run):
        if node.get('status') == 'pending':
            live = [a for a in node.get('attempts') or [] if a.get('status') in ('queued', 'running')]
            return f'wait: {node.get("id")} has {_plural(len(live), "attempt")} running'
    return 'wait: the coordinator is running'


def _task_url(tasks, task_id):
    task = (tasks or {}).get(task_id) or {}
    steps = task.get('steps') or [{}]
    return (steps[0] or {}).get('url') or ''


def attempt_view(a, tasks=None):
    verdict = a.get('verdict') or {}
    failed = [{'kind': c.get('kind'), 'what': c.get('file') or c.get('command') or '',
               'output': str(c.get('output') or '')[:300] if c.get('public', True) else '(hidden)'}
              for c in verdict.get('checks') or [] if not c.get('passed')]
    view = {'id': a.get('id'), 'kind': a.get('kind'), 'strategy': a.get('strategy'), 'status': a.get('status'),
            'failure': a.get('failure') or '', 'engine': a.get('engine') or '', 'node': a.get('node') or '',
            'model': a.get('model') or '', 'generation': a.get('generation') or 0, 'task_id': a.get('task_id') or '',
            'error': str(a.get('error') or '')[:300], 'failed_checks': failed}
    if tasks is not None:
        view['url'] = _task_url(tasks, a.get('task_id'))
    kernel = a.get('kernel') if isinstance(a.get('kernel'), dict) else None
    if kernel:                                  # a kernel-lane attempt: a spec-sheet build or a unit split, no task
        view['kernel'] = {'mode': kernel.get('mode') or '', 'units': _count(kernel.get('units_accepted')),
                          'total': _count(kernel.get('units_total')), 'stalled': kernel.get('stalled') or '',
                          'unit': kernel.get('heading') or kernel.get('unit') or '', 'run_dir': kernel.get('run_dir') or ''}
    return view


def _kernel_note(a):
    k = a.get('kernel')
    if not k:
        return ''
    if k['mode'] == 'split':
        return f'  split {k["unit"]}'
    return f'  units {k["units"]}/{k["total"]}' + (f' (stopped at {k["stalled"]})' if k['stalled'] and a['status'] != 'accepted' else '')


def run_view(run):
    """A compact, stable view of a run row for --json and the human rendering."""
    tasks = run.get('tasks') if isinstance(run.get('tasks'), dict) else None
    nodes = [{'id': n.get('id'), 'parent': n.get('parent'), 'depth': n.get('depth') or 0, 'status': n.get('status'),
              'statement': (n.get('statement') or '')[:200], 'label': statement_label(n.get('statement'))[:200],
              'winner': n.get('winner') or '',
              'generation': n.get('generation') or 0, 'children': n.get('children') or [],
              'error': n.get('error') or '', 'stale': _count(n.get('stale')), 'progress': _progress_counts(n),
              'perpetual': bool(n.get('perpetual')), 'items_total': _count(n.get('items_total')),
              'handoff_stale': _count(n.get('handoff_stale')), 'integrations': _count(n.get('integrations')),
              'attempts': [attempt_view(a, tasks) for a in n.get('attempts') or []]}
             for n in run_tree(run)]
    return {'id': run.get('id'), 'status': run.get('status'), 'error': run.get('error') or '',
            'created': run.get('created'), 'updated': run.get('updated'), 'base': run.get('base') or {},
            'budget': run.get('budget') or {}, 'until_done': _until_done(run),
            'resume_required': bool(run.get('resume_required')),
            'nodes': nodes, 'final': run.get('final'), 'next_action': run_next(run)}


def show_run(run, as_json=False):
    v = run_view(run)
    if as_json:
        print(json.dumps(v, indent=2, ensure_ascii=False))
        return
    base, budget = v['base'], v['budget']
    print(f'{v["id"]}  {v["status"]}  {_plural(len(run.get("lines") or []), "statement")} on {base.get("node")} '
          f'via {base.get("engine")}{(" " + base["model"]) if base.get("model") else ""}  workspace {base.get("cwd")}')
    line = f'  budget: agents {budget.get("agents_started", 0)}/{_agents_cap(budget)}'
    if budget.get('deadline') is not None:            # null: no clock (until_done with wall_seconds 0)
        line += f'  deadline {_when(budget["deadline"])}'
    print(line + ('  until done' if v['until_done'] else ''))
    for n in v['nodes']:
        pad = '  ' + '  ' * n['depth']
        extra = f'  winner {n["winner"]}' if n['winner'] else ''
        extra += f'  -> {", ".join(n["children"])}' if n['children'] else ''
        extra += f'  gen {n["generation"]}' if n['generation'] else ''
        extra += f'  stale {n["stale"]}' if n['stale'] else ''
        extra += f'  handoff stale {n["handoff_stale"]}' if n['handoff_stale'] else ''
        extra += f'  integrations {n["integrations"]}' if n['integrations'] else ''
        p = n['progress']
        extra += f'  progress files {p["files"]} checks {p["checks"]} done {p["done"]}' if any(p.values()) else ''
        extra += f' units {p["units"]}' if p.get('units') else ''
        extra += f'  items {n["items_total"]}' if n['perpetual'] else ''
        print(f'{pad}{n["id"]}  {n["status"]}{extra}  {n["label"][:90]}')
        if n['error']:
            print(f'{pad}    error: {n["error"][:200]}')
        for a in n['attempts']:
            if a['kind'] == 'integration':
                # no agent ran: every child was accepted, the assembled result failed the parent's own checks
                label = 'integration check failed' if a['status'] == 'failed' else f'integration {a["status"]}'
                print(f'{pad}    {a["id"]} {label}')
            else:
                where = f'{a["engine"]}@{a["node"]}' + (f' {a["model"]}' if a['model'] else '')
                gen = f' gen {a["generation"]}' if a['generation'] else ''
                print(f'{pad}    {a["id"]} {a["kind"]}/{a["strategy"]} {a["status"]}'
                      f'{(" " + a["failure"]) if a["failure"] else ""}{gen}  {where}{_kernel_note(a)}')
            for c in a['failed_checks'][:4]:
                first = (c['output'].strip().splitlines() or [''])[-1][:140]
                print(f'{pad}      check {c["kind"]} {c["what"][:60]}: {first}')
            if a['error'] and not a['failed_checks']:
                print(f'{pad}      error: {a["error"][:200]}')
            if a.get('url'):
                print(f'{pad}      terminal: {a["url"]}')
            elif a['task_id'] and a['status'] in ('queued', 'running'):
                print(f'{pad}      task: {a["task_id"]}')
            elif a.get('kernel') and a['kernel']['run_dir'] and a['status'] in ('queued', 'running'):
                print(f'{pad}      build: {a["kernel"]["run_dir"]} (log {a["kernel"]["run_dir"]}.log)')
    final = v['final']
    if isinstance(final, dict):
        checks = final.get('checks') or []
        print(f'  final: {sum(1 for c in checks if c.get("passed"))}/{len(checks)} check(s) passed')
        for c in checks:
            if not c.get('passed'):
                print(f'    failed: {c.get("command")}: {(str(c.get("output") or "").strip().splitlines() or [""])[-1][:140]}')
    if v['error']:
        print(f'  error: {v["error"]}')
    print(f'  next: {v["next_action"]}')


def run_status_line(run):
    return f'{run.get("status")} ' + ' '.join(
        f'{n.get("id")}:{n.get("status")}({_plural(len(n.get("attempts") or []), "attempt")})' for n in run_tree(run))


