def cmd_autogen_wait(o, args):
    if not args:
        print('autogen wait needs a RUN_ID'); return USAGE
    limit = float(o.get('max') or 6 * 3600)
    interval = max(3.0, float(o.get('interval') or 20))
    started = time.time()
    last = ''
    outage = None
    absent = 0
    while True:
        try:
            run = (request('autogen/get', query={'id': args[0]}) or {}).get('run') or {}
        except ApiError as e:
            # The run record survives a restart of the host's web server; the wait does too, for a bounded time.
            if e.exit_code != NO_ANSWER:
                raise
            outage = outage or time.time()
            if time.time() - outage > 180:
                raise
            if not o.get('json'):
                print(f'{time.strftime("%H:%M:%S")}  host not answering; retrying')
            time.sleep(5)
            continue
        outage = None
        line = run_status_line(run)
        if line != last and not o.get('json'):
            print(f'{time.strftime("%H:%M:%S")}  {line}')
            last = line
        # resume_required is briefly true between a start and its worker taking the lock: two polls in a row.
        absent = absent + 1 if run.get('resume_required') else 0
        if run.get('status') in AUTOGEN_TERMINAL or absent >= 2:
            show_run(run, o.get('json'))
            return REFUSED if run.get('status') in ('failed', 'unknown', 'cancelled', 'stuck') else OK
        if time.time() - started > limit:
            show_run(run, o.get('json'))
            if not o.get('json'):
                print(f'wait: {limit:.0f}s reached; the run is still going (symblic-task autogen wait {args[0]} again)')
            return TIMED_OUT
        time.sleep(interval)


def cmd_autogen_control(action, o, args):
    if not args:
        print(f'autogen {action} needs a RUN_ID'); return USAGE
    body = {'id': args[0], 'action': action}
    # resume RUN_ID --agents-max N --wall-seconds S raises a spent explicit cap (0 lifts it, until_done only);
    # only the keys given are sent, and the server checks them against the run's policy
    extend = {key: _int_flag(o, key) for key in ('agents_max', 'wall_seconds') if key in o}
    if extend and action != 'resume':
        print('--agents-max/--wall-seconds extend a resume; autogen cancel takes only RUN_ID'); return USAGE
    if extend:
        body['extend'] = extend
    try:
        d = request('autogen/control', body)
    except ApiError as e:
        if e.status != 409 or not e.data.get('error'):
            raise
        print(e.data['error'], file=sys.stderr)          # the server's refusal, verbatim
        key = re.search(r'extend \{"(agents_max|wall_seconds)"', e.data['error'])
        if key and action == 'resume':
            print(f'with this CLI: symblic-task autogen resume {args[0]} --{key.group(1).replace("_", "-")} N', file=sys.stderr)
        return REFUSED
    run = d.get('run') or {}
    show_run(run, o.get('json'))
    # the server takes an extension only when it resumes a stuck run; say so when the run does not carry it
    applied = {'agents_max': (run.get('budget') or {}).get('agents_max'),
               'wall_seconds': (run.get('policy') or {}).get('wall_seconds')}
    unchanged = [key for key, value in extend.items() if applied[key] != value]
    if unchanged and not o.get('json'):
        print(f'note: {", ".join(unchanged)} not changed: an extension applies only when a stuck run is resumed')
    return OK


def cmd_autogen_catalog(o):
    d = request('autogen/catalog')
    if o.get('json'):
        print(json.dumps(d, indent=2, ensure_ascii=False)); return OK
    defaults = d.get('defaults') or {}
    for key, (low, high) in (d.get('limits') or {}).items():
        print(f'  {key:17} {low}-{high}  default {defaults.get(key)}')
    switches = [(key, value) for key, value in defaults.items() if isinstance(value, bool)]
    if switches:
        print('switches:', '  '.join(f'{key} {"true" if value else "false"}' for key, value in switches))
    if 'until_done' in defaults:
        print('until_done: agents_max and wall_seconds default to 0 (unlimited) unless given; a spent cap or no novel '
              'action leaves the run stuck (resumable), not failed')
    print('strategies:', ', '.join(d.get('strategies') or []), '  default', ','.join(defaults.get('strategies') or []))
    print('failure classes:', ', '.join(d.get('failure_classes') or []))
    print(f'handoff files: {d.get("handoff_file")} + {d.get("checkpoint_file")}')
    return OK


def cmd_autogen(o, args):
    sub, rest = (args[0] if args else ''), args[1:]
    if sub == 'list':
        return cmd_autogen_list(o)
    if sub == 'catalog':
        return cmd_autogen_catalog(o)
    if sub == 'get':
        return cmd_autogen_get(o, rest)
    if sub == 'wait':
        return cmd_autogen_wait(o, rest)
    if sub in ('cancel', 'resume'):
        return cmd_autogen_control(sub, o, rest)
    print('autogen takes list | catalog | get RUN_ID | wait RUN_ID | cancel RUN_ID | resume RUN_ID')
    return USAGE


USAGE_TEXT = __doc__.split('\n\n')[1]
FLAGS_WITH_VALUE = {'--root', '--cwd', '--node', '--engine', '--model', '--effort', '--mode', '--context-note', '--sheet',
                    '--parallel', '--id', '--lines', '--instruction', '--max', '--interval', '--status', '--limit',
                    '--candidates', '--regenerate', '--decompose', '--children', '--handoff', '--perpetual',
                    '--agents-max', '--attempt-seconds', '--wall-seconds', '--strategies', '--check', '--final', '--hidden',
                    '--novelty-limit', '--saturation'}
REPEATABLE = {'--check', '--final', '--hidden'}


def parse(argv):
    opts, args = {}, []
    it = iter(argv)
    for a in it:
        if a in FLAGS_WITH_VALUE:
            try:
                value = next(it)
            except StopIteration:
                raise ApiError(f'{a} needs a value', USAGE) from None
            if a in REPEATABLE:
                opts.setdefault(a[2:].replace('-', '_'), []).append(value)
            else:
                opts[a[2:].replace('-', '_')] = value
        elif a in ('--json', '--screen', '--no-auto', '--worktree', '--auto-next', '--headless',
                   '--autogen', '--no-syntax', '--allow-no-change', '--no-headless', '--tasks',
                   '--until-done', '--designer', '--no-self-split'):
            opts[a[2:].replace('-', '_')] = True
        elif a in ('-h', '--help'):
            opts['help'] = True
        else:
            args.append(a)
    return opts, args


def main(argv):
    try:
        opts, args = parse(argv)
        if opts.get('help') or not args:
            print(USAGE_TEXT)
            return OK if opts.get('help') else USAGE
        cmd, rest = args[0], args[1:]
        if cmd == 'catalog':
            return cmd_catalog(opts)
        if cmd == 'workspace':
            return cmd_workspace(opts, rest)
        if cmd == 'lint':
            return cmd_lint(opts, rest)
        if cmd == 'start':
            return cmd_start(opts)
        if cmd == 'get':
            return cmd_get(opts, rest)
        if cmd == 'wait':
            return cmd_wait(opts, rest)
        if cmd in ('next', 'resume', 'cancel'):
            return cmd_control(cmd, opts, rest)
        if cmd == 'list':
            return cmd_list(opts)
        if cmd == 'autogen':
            return cmd_autogen(opts, rest)
    except ApiError as e:
        print(f'symblic-task: {e}', file=sys.stderr)
        return e.exit_code
    print(USAGE_TEXT)
    return USAGE


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:            # `| head` closed the pipe: not an error
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(OK)
