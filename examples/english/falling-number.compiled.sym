use profile=verified.
let digit = 7.
let width = 20.
let height = 7.
let x = 5.
let row_0 = 6.
show {kind: "grid", value: digit, x: x, y: row_0, width: width, height: height}.
ask row_1: Int "Subtract 1 from the numeric CONTEXT value named row_0. Return the difference." from row_0 with context=none, determine=false, solve=false, retries=2, budget=12000.
ensure row_1 = (row_0 - 1) else retry because "Accept only if 'row 1' equals 'row 0' minus 1.".
ensure row_1 >= 0 else retry because "Accept only if 'row 1' is at least 0.".
ensure row_1 <= (height - 1) else retry because "Accept only if 'row 1' is at most height minus 1.".
assert row_1 >= 0 and row_1 < height.
show {kind: "grid", value: digit, x: x, y: row_1, width: width, height: height}.
